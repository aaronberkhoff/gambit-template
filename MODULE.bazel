# MODULE.bazel
module(name = "gambit_template", version = "0.1.0")

# C++ build
bazel_dep(name = "rules_cc", version = "0.1.1")

# Python rules and toolchain
bazel_dep(name = "rules_python", version = "1.6.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
    is_default = True,
)
use_repo(python, "python_3_12")

# UV for fast dependency management
bazel_dep(name = "rules_uv", version = "0.88.0")

# Configure rules_python to read the UV-generated lock file
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "gambit_pip_deps",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "gambit_pip_deps")

# Pybind11 for Python bindings
bazel_dep(name = "pybind11_bazel", version = "2.13.6")

# Platforms
bazel_dep(name = "platforms", version = "1.0.0")

